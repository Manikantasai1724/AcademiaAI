# ==============================================================================
# Environment Configuration Template
# Academic NLP Question Answering & Semantic Search System
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Gemini LLM API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Dense Embedding Model Configuration (Sentence Transformers)
# Default: sentence-transformers/all-mpnet-base-v2 (768-dimensional dense vectors)
EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# Storage & Retrieval Settings
DATA_DIR=data
DOCUMENTS_UPLOAD_DIR=data/uploads
FAISS_INDEX_DIR=data/faiss
FAISS_INDEX_FILE=index.bin
METADATA_STORE_FILE=metadata.json

# Semantic Search & Grounding Thresholds
# Chunks with cosine similarity score below this threshold are discarded
SIMILARITY_THRESHOLD=0.35
TOP_K=5

# Text Chunking Defaults (token/character budget)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
